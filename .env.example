# --- Database -------------------------------------------------------------
# Local development needs no Turso account: the same @libsql/client driver
# handles a plain file URL. Leave TURSO_AUTH_TOKEN unset locally.
TURSO_DATABASE_URL="file:./local.db"
TURSO_AUTH_TOKEN=""

# In production (Vercel), point these at your Turso database:
#   TURSO_DATABASE_URL="libsql://<db>-<org>.turso.io"
#   TURSO_AUTH_TOKEN="<token from `turso db tokens create <db>`>"

# --- Auth -----------------------------------------------------------------
# Required in production. Generate with: npx auth secret
# Development falls back to a fixed placeholder if this is empty.
AUTH_SECRET=""

# Google OAuth credentials (console.cloud.google.com -> Credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Local development only -----------------------------------------------
# Set to "true" to show an account picker on /signin that signs you in as
# any seeded user without Google. Ignored entirely when NODE_ENV=production.
# (AUTH_DEV_EMAIL still works if you prefer auto-login as one fixed account.)
AUTH_DEV_LOGIN=""

# Secret for the scheduled weekly rollup (Vercel Cron).
# Without this the /api/cron/rollup route refuses outright.
CRON_SECRET=""
