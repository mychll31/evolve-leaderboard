# --- Database -------------------------------------------------------------
# Local development needs no Turso account: the same @libsql/client driver
# handles a plain file URL. Leave TURSO_AUTH_TOKEN unset locally.
TURSO_DATABASE_URL="file:./local.db"
TURSO_AUTH_TOKEN=""

# In production (Vercel), point these at your Turso database:
#   TURSO_DATABASE_URL="libsql://<db>-<org>.turso.io"
#   TURSO_AUTH_TOKEN="<token from `turso db tokens create <db>`>"

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials (console.cloud.google.com -> Credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Local development only -----------------------------------------------
# Set to a seeded user email to bypass Google sign-in while developing.
# Ignored entirely when NODE_ENV=production.
AUTH_DEV_EMAIL=""
